{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;api-gateway",


  "Jwt": {
    "Authority": "http://localhost:8080/realms/petcare",
    "Issuer": "appointment-service",
    "Audience": "petcare",
    "ClientId": "api-gateway",
    "RequireHttpsMetadata": false,
    "SigningKey": "dev-only-signing-key-change-me-32-chars-minimum!!"
  },

  "ReverseProxy": {
    "Routes": {
      "pet-route": {
        "ClusterId": "pet-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/pet/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/pet"
          }
        ]
      },

      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/appointment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/appointment"
          }
        ]
      },

      "treatment-route": {
        "ClusterId": "treatment-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/treatment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/treatment"
          }
        ]
      },

      "mcp-route": {
        "ClusterId": "mcp-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "pet-cluster": {
        "Destinations": {
          "pet-service": {
            "Address": "http://localhost:5101/"
          }
        }
      },

      "appointment-cluster": {
        "Destinations": {
          "appointment-service": {
            "Address": "http://localhost:5102/"
          }
        }
      },

      "treatment-cluster": {
        "Destinations": {
          "treatment-service": {
            "Address": "http://localhost:5103/"
          }
        }
      },

      "mcp-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:10:00",
          "AllowResponseBuffering": "false"
        },
        "Destinations": {
          "mcp-server": {
            "Address": "http://localhost:5044/"
          }
        }
      }
    }
  }

}
