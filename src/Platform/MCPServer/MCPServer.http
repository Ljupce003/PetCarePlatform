@MCPServer_HostAddress = http://localhost:5044

### Health is intentionally anonymous.
GET {{MCPServer_HostAddress}}/health

### Initialize the trusted anonymous Streamable HTTP MCP connection.
POST {{MCPServer_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-11-25",
    "capabilities": {},
    "clientInfo": {
      "name": "PetCare HTTP client",
      "version": "1.0"
    }
  }
}

### List every currently registered MCP tool.
POST {{MCPServer_HostAddress}}/mcp
MCP-Protocol-Version: 2025-11-25
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

###
