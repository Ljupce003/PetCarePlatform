@PetService_HostAddress = http://localhost:5224
@Keycloak_HostAddress = http://localhost:8080
@demoOwnerId = 33333333-3333-3333-3333-333333333333
@demoPetId = 44444444-4444-4444-4444-444444444444

# Replace these after running the create requests when testing update/delete.
@createdOwnerId = 00000000-0000-0000-0000-000000000000
@createdPetId = 00000000-0000-0000-0000-000000000000

### Get an owner token from Keycloak
POST {{Keycloak_HostAddress}}/realms/petcare/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=petcare-demo&username=owner1&password=Owner123!

> {%
    client.global.set("ownerToken", response.body.access_token);
%}

### Get a service token used by Appointment Service for ownership verification
POST {{Keycloak_HostAddress}}/realms/petcare/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=appointment-service&client_secret=appointment-secret

> {%
    client.global.set("serviceToken", response.body.access_token);
%}

### Full health report, including the database check
GET {{PetService_HostAddress}}/health

### Liveness only — does not touch the database
GET {{PetService_HostAddress}}/health/live

### OpenAPI document
GET {{PetService_HostAddress}}/openapi/v1.json

### Swagger UI is served at {{PetService_HostAddress}}/swagger

### List owners
GET {{PetService_HostAddress}}/owners
Accept: application/json
Authorization: Bearer {{ownerToken}}

### Get the seeded demo owner
GET {{PetService_HostAddress}}/owners/{{demoOwnerId}}
Accept: application/json
Authorization: Bearer {{ownerToken}}

### Create an owner
POST {{PetService_HostAddress}}/owners
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "ownerName": "Sara Nikolova",
  "email": "sara.nikolova@example.com",
  "phone": "+389 72 555 111",
  "address": "Skopje"
}

### Update an owner (replace createdOwnerId first)
PUT {{PetService_HostAddress}}/owners/{{createdOwnerId}}
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "ownerName": "Sara Nikolova",
  "email": "sara.updated@example.com",
  "phone": "+389 72 555 111",
  "address": "Bitola"
}

### Delete an owner (replace createdOwnerId first)
DELETE {{PetService_HostAddress}}/owners/{{createdOwnerId}}
Authorization: Bearer {{ownerToken}}

### List the seeded owner's pets
GET {{PetService_HostAddress}}/owners/{{demoOwnerId}}/pets
Accept: application/json
Authorization: Bearer {{ownerToken}}

### List pets
GET {{PetService_HostAddress}}/pets
Accept: application/json
Authorization: Bearer {{ownerToken}}

### Get the seeded demo pet
GET {{PetService_HostAddress}}/pets/{{demoPetId}}
Accept: application/json
Authorization: Bearer {{ownerToken}}

### Register a pet for the seeded owner
POST {{PetService_HostAddress}}/pets
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "ownerId": "{{demoOwnerId}}",
  "name": "Bella",
  "species": "Dog",
  "breed": "Beagle",
  "birthDate": "2023-04-16",
  "weight": 11.4,
  "microchipNumber": "API000000001",
  "allergies": ["Pollen"],
  "chronicConditions": []
}

### Update a pet (replace createdPetId first)
PUT {{PetService_HostAddress}}/pets/{{createdPetId}}
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Bella",
  "species": "Dog",
  "breed": "Beagle",
  "birthDate": "2023-04-16",
  "weight": 12.1,
  "microchipNumber": "API000000001",
  "allergies": ["Pollen"],
  "chronicConditions": []
}

### Delete a pet (replace createdPetId first)
DELETE {{PetService_HostAddress}}/pets/{{createdPetId}}
Authorization: Bearer {{ownerToken}}

### Verify the seeded pet belongs to the seeded owner
GET {{PetService_HostAddress}}/pets/{{demoPetId}}/exists?ownerId={{demoOwnerId}}
Accept: application/json
Authorization: Bearer {{serviceToken}}
