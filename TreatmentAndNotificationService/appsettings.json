{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5553;Database=treatments_db;Username=postgres;Password=mysecretpassword"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "GroupId": "treatment-notification-service",
    "Topic": "petcare.appointments",
    "DeadLetterTopic": "petcare.appointments.dlq",
    "MaxProcessingAttempts": 3,
    "RetryDelayMilliseconds": 1000
  },
  "Consul": {
    "Address": "http://localhost:8500"
  },
  "ServiceRegistration": {
    "Name": "treatment-and-notification-service",
    "Id": "treatment-and-notification-service-1",
    "Address": "localhost",
    "Port": 5103
  },
  "Jwt": {
    "Authority": "http://localhost:8080/realms/petcare",
    "Issuer": "appointment-service",
    "Audience": "petcare",
    "ClientId": "treatment-service",
    "RequireHttpsMetadata": false,
    "SigningKey": "dev-only-signing-key-change-me-32-chars-minimum!!"
  }
}
