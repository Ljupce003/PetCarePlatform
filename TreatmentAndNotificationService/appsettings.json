{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5553;Database=treatments_db;Username=postgres;Password=mysecretpassword"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "GroupId": "treatment-notification-service",
    "Topic": "petcare.appointments",
    "DeadLetterTopic": "petcare.appointments.dlq",
    "MaxProcessingAttempts": 3,
    "RetryDelayMilliseconds": 1000
  }
}
