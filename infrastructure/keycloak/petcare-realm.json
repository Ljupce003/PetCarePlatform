      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222221",
      "username": "vet1",
      "email": "vet1@petcare.local",
      "firstName": "Demo",
      "lastName": "Veterinarian",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["veterinarian"],
      "credentials": [
        { "type": "password", "value": "Vet123!", "temporary": false }
      ]
    },
    {
      "id": "55555555-5555-5555-5555-555555555553",
      "username": "admin1",
      "email": "admin1@petcare.local",
      "firstName": "Demo",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["admin"],
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ]
    },
    {
      "username": "service-account-appointment-service",
      "enabled": true,
      "serviceAccountClientId": "appointment-service",
